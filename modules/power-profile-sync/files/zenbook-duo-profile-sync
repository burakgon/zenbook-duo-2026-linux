#!/bin/bash
# zenbook-duo-profile-sync: complete what power-profiles-daemon cannot do on the UX8407AA.
#
# The legacy platform_profile only offers the choices common to all handlers. asus-wmi
# has "quiet", the Intel SoC Power Slider has "low-power", so neither survives and
# PPD's power-saver leaves the firmware in "balanced" (no Whisper DTT limits, no quiet
# fans). PPD's own platform_profile driver is blocked (drop-in), otherwise its emulated
# power-saver write snaps performance -> power-saver back to balanced. Xe's GuC power
# profile is not managed by PPD at all.
set -u

asus=""; soc=""
for p in /sys/class/platform-profile/*; do
	case "$(cat "$p/name")" in
	asus-wmi) asus="$p/profile" ;;
	"SoC Power Slider") soc="$p/profile" ;;
	esac
done

# write only when different, so the periodic pass is silent and cheap
put() { [[ -n $1 && "$(cat "$1" 2>/dev/null)" != "$2" ]] && echo "$2" >"$1" && changed=1; }
set_gpu() {
	local f
	for f in /sys/class/drm/card*/device/tile*/gt*/freq0/power_profile; do
		[[ -e $f ]] && ! grep -q "\[$1\]" "$f" && echo "$1" >"$f" 2>/dev/null && changed=1
	done
}

apply() {
	local prof changed=0
	prof="$(powerprofilesctl get 2>/dev/null)" || return
	case "$prof" in
	power-saver) put "$asus" quiet; put "$soc" low-power; set_gpu power_saving ;;
	balanced | performance) put "$asus" "$prof"; put "$soc" "$prof"; set_gpu base ;;
	esac
	((changed)) && logger -t zenbook-duo-profile-sync "profile=$prof asus=$(cat "$asus" 2>/dev/null) soc=$(cat "$soc" 2>/dev/null)"
}

apply
# re-check once a minute: firmware may reset a handler on resume, or someone writes it by hand
(while sleep 60; do apply; done) &
gdbus monitor --system --dest org.freedesktop.UPower.PowerProfiles 2>/dev/null |
	while read -r line; do
		[[ $line == *ActiveProfile* ]] && { sleep 0.3; apply; }
	done
