#!/bin/sh
# zenbook-duo-linux: move the Duo keyboard's ASUS control interface from hid-generic to hid-asus.
# Only the interface whose report descriptor starts the 0xff31/0x76 collection is touched:
# typing (interface 0) stays on hid-generic and the touchpad stays on hid-multitouch.
dev="$1"
sys="/sys/bus/hid/devices/$dev"
[ -r "$sys/report_descriptor" ] || exit 0
od -An -tx1 -v "$sys/report_descriptor" | tr -d '\n' | grep -q '06 31 ff 09 76' || exit 0

bus="${dev%%:*}"
rest="${dev#*:}"
vid="${rest%%:*}"
pid="${rest#*:}"
pid="${pid%%.*}"

modprobe hid_asus || exit 0
# 0x20 = QUIRK_USE_KBD_BACKLIGHT; "File exists" on repeat runs is fine
echo "$bus $vid $pid 20" >/sys/bus/hid/drivers/asus/new_id 2>/dev/null
[ "$(basename "$(readlink "$sys/driver")")" = asus ] && exit 0
echo "$dev" >/sys/bus/hid/drivers/hid-generic/unbind 2>/dev/null
echo "$dev" >/sys/bus/hid/drivers/asus/bind 2>/dev/null
exit 0
