#!/bin/sh
# zenbook-duo-linux: Wi-Fi power save follows the power source.
ac=0
for s in /sys/class/power_supply/*; do
	[ "$(cat "$s/type" 2>/dev/null)" = Mains ] && [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && ac=1
done
[ $ac = 1 ] && mode=off || mode=on
for d in /sys/class/net/*/wireless; do
	[ -e "$d" ] || continue
	dev="$(basename "$(dirname "$d")")"
	iw dev "$dev" set power_save "$mode" 2>/dev/null
done
exit 0
