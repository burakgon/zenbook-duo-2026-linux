From 890d7fcebb58f7102c9af7cdcbd01ae480dbd326 Mon Sep 17 00:00:00 2001
From: burakgon <burakgon12@gmail.com>
Date: Tue, 6 Oct 2026 19:38:03 +0300
Subject: [PATCH] drm/i915/cx0: request TCSS power for eDP-2 on the ASUS
 Zenbook Duo UX8407AA

The UX8407AA drives its second internal panel (eDP-2) from Port B. On
Panther Lake that port's PHY is a C20 PHY inside the Type-C subsystem,
yet Port B is not a TC port, so the driver never requests TCSS power for
it. The firmware does, but only when it lights the panel at power-on,
and it skips the panel when the detachable keyboard is lying on it.

After such a power-on the first enable of eDP-2 fails:

  PHY B failed to request refclk
  PHY B failed to change powerdown state
  Failed to bring PHY B to idle.
  Port B PLL not locked
  Timeout waiting for DDI BUF B to get active

and every later commit on pipe B times out (or the machine hangs). The
state survives warm reboots until a full power reset.

Request TCSS power, as the TC PHY code does for TC ports (including the
PTL mailbox workaround 14020908590), before programming the PHY clocks
and wait for the acknowledgement; release it again once the PLL is
disabled. Limited to this board; a module parameter turns it off.

Based on the investigation and the broader patch of the
zenbook-duo26-Ubuntu26.04 project.

Link: https://gitlab.freedesktop.org/drm/xe/kernel/-/issues/9196
Link: https://github.com/therealarnold666/zenbook-duo26-Ubuntu26.04
---
 drivers/gpu/drm/i915/display/intel_cx0_phy.c | 49 ++++++++++++++++++++
 drivers/gpu/drm/i915/display/intel_tc.c      | 23 +++++++++
 drivers/gpu/drm/i915/display/intel_tc.h      |  1 +
 3 files changed, 73 insertions(+)

diff --git a/drivers/gpu/drm/i915/display/intel_cx0_phy.c b/drivers/gpu/drm/i915/display/intel_cx0_phy.c
index 24a51ab..8e32e52 100644
--- a/drivers/gpu/drm/i915/display/intel_cx0_phy.c
+++ b/drivers/gpu/drm/i915/display/intel_cx0_phy.c
@@ -3,8 +3,10 @@
  * Copyright © 2023 Intel Corporation
  */
 
+#include <linux/dmi.h>
 #include <linux/log2.h>
 #include <linux/math64.h>
+#include <linux/moduleparam.h>
 
 #include <drm/drm_print.h>
 
@@ -52,6 +54,45 @@ bool intel_encoder_is_c10phy(struct intel_encoder *encoder)
 	return false;
 }
 
+static bool zenbook_duo_edp2_tcss = true;
+module_param(zenbook_duo_edp2_tcss, bool, 0444);
+MODULE_PARM_DESC(zenbook_duo_edp2_tcss,
+		 "Request TCSS power for eDP-2 on the ASUS Zenbook Duo UX8407AA (default: true)");
+
+/*
+ * ASUS Zenbook Duo UX8407AA (xe #9196): the bottom panel (eDP-2) is on
+ * Port B, whose C20 PHY sits in the Type-C subsystem. Port B is not a TC
+ * port, so nothing in the driver requests TCSS power for it. The firmware
+ * does, but only when it lights the panel at power-on, which it skips while
+ * the keyboard lies on that panel. Without TCSS power the PHY never
+ * acknowledges its refclk and PLL requests, the first enable of eDP-2 fails
+ * ("PHY B failed to request refclk") and every later commit on pipe B stalls.
+ */
+static bool intel_cx0_needs_tcss_power(struct intel_encoder *encoder)
+{
+	struct intel_display *display = to_intel_display(encoder);
+
+	return zenbook_duo_edp2_tcss &&
+	       display->platform.pantherlake &&
+	       encoder->port == PORT_B &&
+	       !intel_encoder_is_c10phy(encoder) &&
+	       !intel_encoder_is_tc(encoder) &&
+	       dmi_match(DMI_BOARD_VENDOR, "ASUSTeK COMPUTER INC.") &&
+	       dmi_match(DMI_BOARD_NAME, "UX8407AA");
+}
+
+static void intel_cx0_request_tcss_power(struct intel_encoder *encoder)
+{
+	struct intel_display *display = to_intel_display(encoder);
+
+	intel_tc_request_tcss_power(encoder, true);
+
+	if (intel_de_wait_for_set_ms(display, XELPDP_PORT_BUF_CTL1(display, encoder->port),
+				     XELPDP_TCSS_POWER_STATE, 5))
+		drm_warn(display->drm, "Port %c: TCSS power request not acknowledged\n",
+			 port_name(encoder->port));
+}
+
 static int lane_mask_to_lane(u8 lane_mask)
 {
 	if (WARN_ON((lane_mask & ~INTEL_CX0_BOTH_LANES) ||
@@ -3189,6 +3230,10 @@ static void intel_cx0pll_enable(struct intel_encoder *encoder,
 	 */
 	drm_WARN_ON(display->drm, lane_reversal && intel_tc_port_in_dp_alt_mode(dig_port));
 
+	/* The PHY must be powered before its clocks are requested. */
+	if (intel_cx0_needs_tcss_power(encoder))
+		intel_cx0_request_tcss_power(encoder);
+
 	/*
 	 * 1. Program PORT_CLOCK_CTL REGISTER to configure
 	 * clock muxes, gating and SSC
@@ -3523,6 +3568,10 @@ static void intel_cx0pll_disable(struct intel_encoder *encoder)
 	intel_de_rmw(display, XELPDP_PORT_CLOCK_CTL(display, encoder->port),
 		     XELPDP_FORWARD_CLOCK_UNGATE, 0);
 
+	/* The next enable requests it again. */
+	if (intel_cx0_needs_tcss_power(encoder))
+		intel_tc_request_tcss_power(encoder, false);
+
 	intel_cx0_phy_transaction_end(encoder, wakeref);
 }
 
diff --git a/drivers/gpu/drm/i915/display/intel_tc.c b/drivers/gpu/drm/i915/display/intel_tc.c
index f2d86b2..4e4263f 100644
--- a/drivers/gpu/drm/i915/display/intel_tc.c
+++ b/drivers/gpu/drm/i915/display/intel_tc.c
@@ -1090,6 +1090,29 @@ static void xelpdp_tc_power_request_wa(struct intel_display *display, bool enabl
 	}
 }
 
+/**
+ * intel_tc_request_tcss_power - request TCSS power for a port's PHY
+ * @encoder: encoder of a non-TC port driven by a PHY inside the Type-C subsystem
+ * @enable: request or release
+ *
+ * For TC ports the TC PHY code handles the request; this is for the rare
+ * native port whose PHY still sits in the TCSS.
+ */
+void intel_tc_request_tcss_power(struct intel_encoder *encoder, bool enable)
+{
+	struct intel_display *display = to_intel_display(encoder);
+	intel_reg_t reg = XELPDP_PORT_BUF_CTL1(display, encoder->port);
+
+	if (!!(intel_de_read(display, reg) & XELPDP_TCSS_POWER_REQUEST) == enable)
+		return;
+
+	if (DISPLAY_VER(display) == 30)
+		xelpdp_tc_power_request_wa(display, enable);
+
+	intel_de_rmw(display, reg, XELPDP_TCSS_POWER_REQUEST,
+		     enable ? XELPDP_TCSS_POWER_REQUEST : 0);
+}
+
 static void __xelpdp_tc_phy_enable_tcss_power(struct intel_tc_port *tc, bool enable)
 {
 	struct intel_display *display = to_intel_display(tc->dig_port);
diff --git a/drivers/gpu/drm/i915/display/intel_tc.h b/drivers/gpu/drm/i915/display/intel_tc.h
index 6719aea..b49a5b5 100644
--- a/drivers/gpu/drm/i915/display/intel_tc.h
+++ b/drivers/gpu/drm/i915/display/intel_tc.h
@@ -88,6 +88,7 @@ bool intel_tc_port_in_legacy_mode(struct intel_digital_port *dig_port);
 bool intel_tc_port_handles_hpd_glitches(struct intel_digital_port *dig_port);
 
 bool intel_tc_port_connected(struct intel_encoder *encoder);
+void intel_tc_request_tcss_power(struct intel_encoder *encoder, bool enable);
 
 enum intel_tc_pin_assignment
 intel_tc_port_get_pin_assignment(struct intel_digital_port *dig_port);
-- 
2.56.0

