[Unit]
Description=Zenbook Duo: rotation, dual-panel layout, touch mapping and keyboard dock
# Runs in the Plasma session and on the Plasma login screen (user plasmalogin).
PartOf=graphical-session.target plasma-login-wayland.target
After=graphical-session.target plasma-kwin_wayland.service plasma-login-kwin_wayland.service
# KWin puts WAYLAND_DISPLAY into the systemd user environment; not set on X11
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/lib/zenbook-duo/duo-rotate
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target plasma-login-wayland.target
