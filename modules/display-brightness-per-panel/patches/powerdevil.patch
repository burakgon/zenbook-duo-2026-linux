+void BacklightDetector::detectSeparateDisplays(QStringList syspaths, std::shared_ptr<DisplayList> deleteOld)
+{
+    if (syspaths.isEmpty()) {
+        Q_EMIT detectionFinished(!m_displays.empty());
+        return;
+    }
+    const QString helperDevice = syspaths.takeFirst();
+    const quint64 serial = m_detectionSerial;
+
+    KAuth::Action brightnessAction(u"org.kde.powerdevil.backlighthelper.brightness"_s);
+    brightnessAction.setHelperId(HELPER_ID);
+    brightnessAction.addArgument(u"device"_s, helperDevice);
+    KAuth::ExecuteJob *brightnessJob = brightnessAction.execute();
+    connect(brightnessJob, &KJob::result, this, [this, brightnessJob, helperDevice, syspaths, serial, deleteOld] {
+        if (serial != m_detectionSerial) {
+            return;
+        }
+        if (brightnessJob->error()) {
+            qCWarning(POWERDEVIL) << "org.kde.powerdevil.backlighthelper.brightness failed for" << helperDevice << brightnessJob->errorText();
+            detectSeparateDisplays(syspaths, deleteOld);
+            return;
+        }
+        const int cachedBrightness = brightnessJob->data()[u"brightness"_s].toInt();
+
+        KAuth::Action brightnessMaxAction(u"org.kde.powerdevil.backlighthelper.brightnessmax"_s);
+        brightnessMaxAction.setHelperId(HELPER_ID);
+        brightnessMaxAction.addArgument(u"device"_s, helperDevice);
+        KAuth::ExecuteJob *brightnessMaxJob = brightnessMaxAction.execute();
+        connect(brightnessMaxJob, &KJob::result, this, [this, brightnessMaxJob, helperDevice, syspaths, cachedBrightness, serial, deleteOld] {
+            if (serial != m_detectionSerial) {
+                return;
+            }
+            const int maxBrightness = brightnessMaxJob->error() ? 0 : brightnessMaxJob->data()[u"brightnessmax"_s].toInt();
+            if (maxBrightness <= 0) {
+                qCWarning(POWERDEVIL) << "org.kde.powerdevil.backlighthelper.brightnessmax failed for" << helperDevice << brightnessMaxJob->errorText();
+                detectSeparateDisplays(syspaths, deleteOld);
+                return;
+            }
+
+            // The backlight's parent is the DRM connector of its panel, e.g.
+            // /sys/devices/pci0000:00/0000:00:02.0/drm/card0/card0-eDP-2/card0-eDP-2-backlight
+            const QString syspath = QFileInfo(helperDevice).symLinkTarget();
+            const QString connectorPath = QFileInfo(syspath).path();
+            QString connector = QFileInfo(connectorPath).fileName();
+            connector = connector.mid(connector.indexOf(u'-') + 1); // card0-eDP-2 -> eDP-2
+
+            std::optional<QByteArray> edid;
+            if (QFile edidFile(connectorPath + u"/edid"_s); edidFile.open(QIODevice::ReadOnly)) {
+                if (QByteArray data = edidFile.readAll(); !data.isEmpty()) {
+                    edid = data;
+                }
+            }
+
+            // keep the id of the first (primary) display stable for existing configurations
+            const QString id = m_displays.empty() ? u"display"_s : u"display:"_s + QFileInfo(helperDevice).fileName();
+            const QString label = i18nc("Display label, %1 is the connector name like eDP-2", "Built-in Screen (%1)", connector);
+            m_displays.emplace_back(new BacklightBrightness(cachedBrightness, maxBrightness, syspath, helperDevice, id, label, edid));
+
+            detectSeparateDisplays(syspaths, deleteOld);
+        });
+        brightnessMaxJob->start();
+    });
+    brightnessJob->start();
+}
