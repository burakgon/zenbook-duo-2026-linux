                        {
                            "mipi-sdca-control-access-mode", 
                            0x05
                        }, 

                        Package (0x02)
                        {
                            "mipi-sdca-control-dc-value", 
                            0x04
                        }
                    }
                })
                Name (BUF0, Buffer (0x09)
                {
                    /* 0000 */  0x09, 0x21, 0x00, 0x01, 0x00, 0x01, 0x22, 0x6A,  // .!...."j
                    /* 0008 */  0x00                                             // .
                })
                Name (BUF1, Buffer (0x6A)
                {
                    /* 0000 */  0x05, 0x0C, 0x09, 0x01, 0xA1, 0x01, 0x85, 0x01,  // ........
                    /* 0008 */  0x15, 0x00, 0x25, 0x01, 0x09, 0xCD, 0x75, 0x01,  // ..%...u.
                    /* 0010 */  0x95, 0x01, 0x81, 0x06, 0x09, 0xB5, 0x75, 0x01,  // ......u.
                    /* 0018 */  0x95, 0x01, 0x81, 0x06, 0x09, 0xCF, 0x75, 0x01,  // ......u.
                    /* 0020 */  0x95, 0x01, 0x81, 0x06, 0x09, 0xE9, 0x75, 0x01,  // ......u.
                    /* 0028 */  0x95, 0x01, 0x81, 0x02, 0x09, 0xEA, 0x75, 0x01,  // ......u.
                    /* 0030 */  0x95, 0x01, 0x81, 0x02, 0x09, 0xB6, 0x75, 0x01,  // ......u.
                    /* 0038 */  0x95, 0x01, 0x81, 0x06, 0x09, 0xE2, 0x75, 0x01,  // ......u.
                    /* 0040 */  0x95, 0x01, 0x81, 0x06, 0x09, 0x00, 0x75, 0x11,  // ......u.
                    /* 0048 */  0x95, 0x01, 0x81, 0x03, 0xC0, 0x05, 0x0B, 0x09,  // ........
                    /* 0050 */  0x05, 0xA1, 0x01, 0x85, 0x02, 0x15, 0x00, 0x25,  // .......%
                    /* 0058 */  0x01, 0x09, 0x2F, 0x75, 0x01, 0x95, 0x01, 0x81,  // ../u....
                    /* 0060 */  0x06, 0x09, 0x00, 0x75, 0x17, 0x95, 0x01, 0x81,  // ...u....
                    /* 0068 */  0x03, 0xC0                                       // ..
                })
                Name (IBUF, Buffer (0x64)
                {
