    Method (GP3C, 0, Serialized)
    {
        If ((PG3S == One))
        {
            If ((GP3M == Zero))
            {
                PG3C (One)
            }
            Else
            {
                PG3C (Zero)
            }
        }
        Else
        {
            PG3C (Zero)
        }
    }

    Name (GP3M, Zero)
    Method (GP3V, 2, Serialized)
    {
        Local0 = (One << Arg0)
        If (Arg1)
