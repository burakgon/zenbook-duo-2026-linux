    Method (RWAK, 1, Serialized)
    {
        D8XH (One, 0xAB)
        ADBG ("_WAK")
        Name (RPWM, Zero)
        If ((DSTS == Zero))
        {
            RPWM = Zero
        }
        Else
        {
            RPWM = 0x0180
        }

        SWAK (Arg0, RPWM)
        If ((Arg0 == 0x03))
        {
            \_SB.PC00.LPCB.ACCF (ACTT)
        }

        If (((Arg0 == 0x03) || (Arg0 == 0x04)))
        {
            If ((GBSX & 0x40))
            {
                If (CondRefOf (\_SB.PC00.GFX0.IUEH))
                {
                    \_SB.PC00.GFX0.IUEH (0x06)
                }

                PB1E ^= 0x08
            }

            If ((GBSX & 0x80))
            {
                If (CondRefOf (\_SB.PC00.GFX0.IUEH))
                {
                    \_SB.PC00.GFX0.IUEH (0x07)
                }

                PB1E ^= 0x10
            }

            \_SB.PC00.LPCB.SWUB (Arg0, GBSX, PB1E, IGDS)
            If (CondRefOf (\_SB.PC00.TXHC))
            {
                \_SB.TCWK (Arg0)
            }
        }

        BPNT ()
        Return (Package (0x02)
        {
            Zero, 
            Zero
        })
