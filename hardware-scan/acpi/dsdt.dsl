                                            "\\_SB.PC00.XHCI.RHUB.HS03.VGPO", 0x00, ResourceConsumer, ,
                                            )
                                            {   // Pin list
                                                0x0000
                                            }
                                        GpioIo (Exclusive, PullDefault, 0x0000, 0x0000, IoRestrictionNone,
                                            "\\_SB.PC00.XHCI.RHUB.HS03.VGPO", 0x00, ResourceConsumer, ,
                                            )
