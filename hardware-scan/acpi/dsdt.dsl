                CreateQWordField (ISUB, 0x98, FSVL)
                CreateQWordField (ISUB, 0xA0, INDE)
                CreateQWordField (ISUB, 0xA8, INDV)
                DADR = T0G0 /* \T0G0 */
                DSPD = T0H0 /* \T0H0 */
                DADM = T0I0 /* \T0I0 */
                SMHX = T0J0 /* \T0J0 */
                SMLX = T0K0 /* \T0K0 */
                SMTD = T0L0 /* \T0L0 */
                SMRD = T0M0 /* \T0M0 */
                FMHX = T0N0 /* \T0N0 */
                FMLX = T0O0 /* \T0O0 */
                FMTD = T0P0 /* \T0P0 */
