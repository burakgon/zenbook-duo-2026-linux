    Scope (_SB)
    {
        Method (SBTE, 1, Serialized)
        {
            Local0 = GBTP /* \GBTP */
            SGOV (Local0, Arg0)
        }

        Method (SBTI, 1, Serialized)
        {
            Local0 = BTIF /* \BTIF */
            SGOV (Local0, Arg0)
        }

        Method (BTRK, 1, Serialized)
        {
            If (CondRefOf (GBTK))
            {
                If ((GBTK != Zero))
                {
                    If (CondRefOf (\_SB.SGOV))
                    {
                        SGOV (GBTK, Arg0)
                    }
                }
            }
            Else
            {
                ADBG ("Set M.2 BT RF-Kill pin failied")
            }
        }

        Method (GBTR, 0, NotSerialized)
        {
            If (CondRefOf (\_SB.GGOV))
            {
                If (CondRefOf (GBTK))
                {
                    Return (GGOV (GBTK))
                }
                Else
                {
                    ADBG ("Get M.2 BT RF-Kill pin failied")
                    Return (Zero)
                }
            }
            Else
            {
                ADBG ("Get M.2 BT RF-Kill pin status failied")
                Return (Zero)
            }
        }
    }

