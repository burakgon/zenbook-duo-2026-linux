    OperationRegion (U3F8, SystemIO, 0x03F8, 0x10)
    Field (U3F8, ByteAcc, Lock, Preserve)
    {
        TXBF,   8, 
        DLM,    8, 
        FCR,    8, 
        LCR,    8, 
        Offset (0x05), 
        LSR,    8
    }

    Method (W2SP, 1, Serialized)
    {
        Local0 = Zero
        While (((LSR & 0x20) != 0x20))
        {
            Stall (0x0A)
            Local0++
            If ((Local0 > 0x64))
            {
                Return (Zero)
            }
        }

        TXBF = Arg0
    }

    Name (SINI, Zero)
    Method (SDBG, 1, Serialized)
    {
        If ((SINI == Zero))
        {
            LCR = 0x83
            TXBF = One
            DLM = Zero
            FCR = 0xE1
            LCR = 0x03
            DLM = Zero
            SINI = One
        }

        ToHexString (Arg0, Local4)
        Local5 = SizeOf (Local4)
        Local6 = Zero
        While ((Local6 < Local5))
        {
            Mid (Local4, Local6, One, Local7)
            W2SP (Local7)
            Local6++
        }

        W2SP (0x0D)
        W2SP (0x0A)
    }

    ADBG ("[DSDT][AcpiTableEntry]")
    OperationRegion (SPRT, SystemIO, 0xB2, 0x02)
    Field (SPRT, ByteAcc, Lock, Preserve)
    {
        SSMP,   8
    }

    Name (AM00, Package (0x02)
    {
        Zero, 
        Zero
    })
    Method (_PIC, 1, NotSerialized)  // _PIC: Interrupt Model
    {
        GPIC = Arg0
        PICM = Arg0
