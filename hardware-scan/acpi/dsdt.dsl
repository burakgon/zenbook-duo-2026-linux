            If ((PCHS == One))
            {
                Device (RP11)
                {
                    Name (_ADR, 0x00060002)  // _ADR: Address
                    Method (_PRT, 0, NotSerialized)  // _PRT: PCI Routing Table
                    {
                        If (PICM)
                        {
                            Return (AR03) /* \_SB_.AR03 */
                        }

                        Return (PD03) /* \_SB_.PD03 */
                    }
