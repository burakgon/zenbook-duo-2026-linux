            Name (EMIM, Zero)
            Name (BCCD, Package (0x00){})
            Name (_DSD, Package (0x02)  // _DSD: Device-Specific Data
            {
                ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301") /* Device Properties for _DSD */, 
                Package (0x01)
                {
                    Package (0x02)
                    {
                        "intel-cec-pson-switching-enabled-in-s0", 
                        Zero
                    }
                }
            })
            Method (PSOP, 0, NotSerialized)
            {
                Local0 = Zero
                While ((Local0 < SizeOf (_DSD)))
                {
                    If ((DerefOf (_DSD [Local0]) != ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301") /* Device Properties for _DSD */))
                    {
                        Continue
                    }

                    Local1 = DerefOf (_DSD [(Local0 + One)])
                    Local2 = Zero
                    While ((Local2 < SizeOf (Local1)))
                    {
                        Local3 = DerefOf (Local1 [Local2])
                        If ((("intel-cec-pson-switching-enabled-in-s0" == DerefOf (Local3 [Zero])) && PSON))
                        {
                            ADBG ("PEPD: Storing 1 in _DSD Object")
                            DerefOf (DerefOf (_DSD [(Local0 + One)]) [
                                Local2]) [One] = One
                        }

                        Local2++
                    }

                    Local0 += 0x02
                }

                Return (Zero)
            }

            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                If ((S0ID == One))
                {
                    PSOP ()
                    Return (0x0F)
                }

                Return (Zero)
            }

            Name (IPDI, Zero)
            Method (PESB, 1, Serialized)
            {
                If ((S0ID == One))
                {
                    GUAM (Arg0)
                }

                If (CondRefOf (\GPRV))
                {
                    If ((Arg0 == One))
                    {
                        ADBG ("[PEP] allow PS_ON!")
                        GPRV (0x03, Zero)
                    }
                    Else
                    {
                        ADBG ("[PEP] veto PS_ON!")
                        GPRV (0x03, One)
                    }
                }
            }

            Name (PCP0, Package (0x02)
            {
                Zero, 
                Package (0x02)
                {
                    0xFF, 
                    Zero
                }
            })
            Name (PCP1, Package (0x02)
            {
                Zero, 
                Package (0x03)
                {
                    0xFF, 
                    Zero, 
                    0x81
                }
            })
            Name (PCP2, Package (0x02)
            {
                Zero, 
                Package (0x02)
                {
                    0xFF, 
                    0x02
                }
            })
            Name (PCP3, Package (0x02)
            {
                Zero, 
                Package (0x02)
                {
                    0xFF, 
                    0x03
                }
            })
            Name (DEVC, Zero)
            Name (DEVS, Zero)
            Name (PEPV, Zero)
            Method (PDIN, 3, Serialized)
            {
                If ((DEVC < DEVS))
                {
                    If ((SizeOf (Arg1) != Zero))
                    {
                        Local0 = Concatenate (Concatenate (Arg0, "."), Arg1)
                        If ((Arg2 != Zero))
                        {
                            Local1 = Zero
                            While ((Local1 < DEVC))
                            {
                                If ((Local0 == DerefOf (DerefOf (DEVY [Local1]) [Zero])))
                                {
                                    Break
                                }

                                Local1 += One
                            }

                            If ((Local1 == DEVC))
                            {
                                DerefOf (DEVY [Local1]) [Zero] = Local0
                            }

                            DerefOf (DEVY [Local1]) [One] = One
                            If ((Arg2 == One))
                            {
                                DerefOf (DEVY [Local1]) [0x02] = PCP1 /* \_SB_.PEPD.PCP1 */
                            }
                            ElseIf ((Arg2 == 0x02))
                            {
                                DerefOf (DEVY [Local1]) [0x02] = PCP2 /* \_SB_.PEPD.PCP2 */
                            }
                            ElseIf ((Arg2 == 0x03))
                            {
                                DerefOf (DEVY [Local1]) [0x02] = PCP3 /* \_SB_.PEPD.PCP3 */
                            }
                            ElseIf ((Arg2 == 0x04))
                            {
                                DerefOf (DEVY [Local1]) [0x02] = PCP0 /* \_SB_.PEPD.PCP0 */
                            }
                            ElseIf ((Arg2 == 0x05))
                            {
                                DerefOf (DEVY [Local1]) [One] = Zero
                            }

                            If ((Arg2 != 0x05))
                            {
                                ADBG (Concatenate ("DEVY entry index :", ToDecimalString (Local1)))
                                ADBG (Concatenate ("Device Descriptor                   :", DerefOf (DerefOf (DEVY [Local1]) [Zero])
                                    ))
                                ADBG (Concatenate ("Constraint value (0 - 5, reserved)  :", Arg2))
                                ADBG ("------------ ")
                                ADBG ("")
                            }
                            ElseIf ((Arg0 != "Reserved"))
                            {
                                ADBG (Concatenate ("DEVY entry index :", ToDecimalString (Local1)))
                                ADBG (Concatenate ("Device Descriptor (Disable)         :", DerefOf (DerefOf (DEVY [Local1]) [Zero])
                                    ))
                            }

                            If ((Local1 == DEVC))
                            {
                                DEVC++
                            }
                        }
                    }
                }
                Else
                {
                    ADBG (Concatenate ("PEP UPDE Error!!!! DEVY size is excedded, DEVY size = ", ToDecimalString (DEVS)))
                }
            }

            Method (PFEK, 3, Serialized)
            {
                ADBG (Concatenate ("PFEK Adress: ", ToHexString (Arg0)))
                If (CondRefOf (\_SB.PC00.PC2M))
                {
                    Local0 = Arg1
                    OperationRegion (PCFG, SystemMemory, ^^PC00.PC2M (Arg0, Local0), 0x10)
                    Field (PCFG, AnyAcc, NoLock, Preserve)
                    {
                        VDID,   16, 
                        DDID,   16, 
                        Offset (0x0A), 
                        SCCX,   8, 
                        BCCX,   8
                    }

                    If ((VDID != 0xFFFF))
                    {
                        If (((BCCX == One) && (SCCX == 0x06)))
                        {
                            ADBG ("PFEK check for AHCI controller!")
                            If ((DDID == 0xB07F))
                            {
                                Return (Zero)
                            }
                        }

                        Return (Arg2)
                    }
                    Else
                    {
                        Return (0x05)
                    }
                }
                Else
                {
                    ADBG ("FATAL ERROR: PC2M is not support!")
                    Return (Zero)
                }
            }

            Method (PRCI, 0, Serialized)
            {
                PEPV = One
                If (CondRefOf (\_SB.PEPD.CUCO))
                {
                    PEPV = CUCO (PEPV)
                }

                ADBG (Concatenate ("PEP CPU TCNT: ", ToHexString (TCNT)))
                If ((PEPV != Zero))
                {
                    Local0 = Zero
                    While ((Local0 < TCNT))
                    {
                        If ((Local0 < 0x0A))
                        {
                            Concatenate ("PR0", ToDecimalString (Local0), Local1)
                        }
                        Else
                        {
                            Concatenate ("PR", ToDecimalString (Local0), Local1)
                        }

                        PDIN ("\\_SB", Local1, 0x04)
                        Local0 += One
                    }
                }
            }

            Method (UPDV, 0, Serialized)
            {
                ADBG (Concatenate ("UPDV start, DEVS: ", SizeOf (DEVY)))
                ADBG ("Note: constraint value map:")
                ADBG ("     0 - disable")
                ADBG ("     1 - DOF1")
                ADBG ("     2 - D2")
                ADBG ("     3 - D3")
                ADBG ("     4 - Enable with D0")
                ADBG ("     5 - Disable and keep default setting")
                DEVS = SizeOf (DEVY)
                PRCI ()
                PEPV = Zero
                If (CondRefOf (\_SB.PC00.GFX0))
                {
                    PEPV = PFEK (^^PC00.GFX0._ADR, Zero, 0x03)
                    If (CondRefOf (\_SB.PC00.GFX0.POVR))
                    {
                        PEPV = ^^PC00.GFX0.POVR (PEPV)
                    }
                }

                PDIN ("\\_SB.PC00", "GFX0", PEPV)
                PEPV = Zero
                If (CondRefOf (\_SB.PC00.UA00))
                {
                    PEPV = PFEK (^^PC00.UA00._ADR (), Zero, 0x03)
                    If (CondRefOf (\_SB.PC00.UA00.POVR))
                    {
                        PEPV = ^^PC00.UA00.POVR (PEPV)
                    }
                }

                PDIN ("\\_SB.PC00", "UA00", PEPV)
                PEPV = Zero
                If (CondRefOf (\_SB.PC00.UA01))
                {
                    PEPV = PFEK (^^PC00.UA01._ADR (), Zero, 0x03)
                    If (CondRefOf (\_SB.PC00.UA01.POVR))
                    {
                        PEPV = ^^PC00.UA01.POVR (PEPV)
                    }
                }

                PDIN ("\\_SB.PC00", "UA01", PEPV)
                PEPV = Zero
                If (CondRefOf (\_SB.PC00.UA02))
                {
                    PEPV = PFEK (^^PC00.UA02._ADR (), Zero, 0x03)
                    If (CondRefOf (\_SB.PC00.UA02.POVR))
                    {
                        PEPV = ^^PC00.UA02.POVR (PEPV)
                    }
                }

                PDIN ("\\_SB.PC00", "UA02", PEPV)
                PEPV = Zero
                If (CondRefOf (\_SB.PC00.I2C0))
                {
                    PEPV = PFEK (^^PC00.I2C0._ADR (), Zero, 0x03)
                    If (CondRefOf (\_SB.PC00.I2C0.POVR))
                    {
                        PEPV = ^^PC00.I2C0.POVR (PEPV)
                    }
                }

                PDIN ("\\_SB.PC00", "I2C0", PEPV)
                PEPV = Zero
                If (CondRefOf (\_SB.PC00.I2C1))
                {
                    PEPV = PFEK (^^PC00.I2C1._ADR (), Zero, 0x03)
                    If (CondRefOf (\_SB.PC00.I2C1.POVR))
                    {
                        PEPV = ^^PC00.I2C1.POVR (PEPV)
                    }
                }

