                PDIN ("\\_SB.PC02", "RP28", PEPV)
                Local0 = DEVC /* \_SB_.PEPD.DEVC */
                While ((Local0 < DEVS))
                {
                    PDIN ("Reserved", ToDecimalString (Local0), 0x05)
                    Local0 += One
                }
            }

            Method (ECEN, 0, Serialized)
            {
                If ((MSEN == Zero))
                {
                    ADBG ("ECEN Method Entry")
                    MSEN = One
                    PESB (One)
                }
            }

            Method (ECEX, 0, Serialized)
            {
                If ((MSEN == One))
                {
                    ADBG ("ECEN Method Exit")
                    MSEN = Zero
                    PESB (Zero)
                }
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                ADBG ("Pep _DSM!")
                If ((Arg0 == ToUUID ("11e00d56-ce64-47ce-837b-1f898f9aa461") /* Unknown UUID */))
                {
                    If ((Arg2 == Zero))
                    {
                        Return (Buffer (0x02)
                        {
                             0x81, 0x03                                       // ..
                        })
                    }

                    If ((Arg2 == 0x07))
                    {
                        ADBG ("[PEP] Modern Standby Entry")
                        ECEN ()
                        ^^PC00.LPCB.EC0.ST9A ()
                    }

                    If ((Arg2 == 0x08))
                    {
                        ADBG ("[PEP] Modern Standby Exit")
                        ECEX ()
                        ^^PC00.LPCB.EC0.ST9B ()
                    }

                    If ((Arg2 == 0x09))
                    {
                        ADBG ("[PEP] Intent to turn on display notification ")
                    }
                }

                If ((Arg0 == ToUUID ("c4eb40a0-6cd2-11e2-bcfd-0800200c9a66") /* Unknown UUID */))
                {
                    If ((Arg2 == Zero))
                    {
                        Return (Buffer (One)
                        {
                             0x7F                                             // .
                        })
                    }

                    If ((Arg2 == One))
                    {
                        If ((S0ID == Zero))
                        {
                            Return (Package (0x00){})
                        }

                        If ((IPDI == Zero))
                        {
                            UPDV ()
                            IPDI = One
                        }
                        Else
                        {
                            ADBG ("PEP DEVY is already initialized !!! ")
                        }

                        Return (DEVY) /* \_SB_.PEPD.DEVY */
                    }

                    If ((Arg2 == 0x02))
                    {
                        Return (BCCD) /* \_SB_.PEPD.BCCD */
                    }

                    If ((Arg2 == 0x03))
                    {
                        EMIM = One
                        ^^PC00.GFX0.HPMS (Zero)
                        If (CondRefOf (\_SB.PC00.IMNG))
                        {
                            ^^PC00.IMNG (Arg2)
                        }

                        If ((S0ID == One))
                        {
                            D8XH (Zero, 0xC5)
                            D8XH (One, Zero)
                            ^^PC00.LPCB.EC0.CSEE (0xB7)
                        }
                    }

                    If ((Arg2 == 0x04))
                    {
                        EMIM = Zero
                        If (CondRefOf (\_SB.PC00.IMNG))
                        {
                            ^^PC00.IMNG (Arg2)
                        }

                        If ((S0ID == One))
                        {
                            D8XH (Zero, 0xC5)
                            D8XH (One, 0xAB)
                        }

                        ^^PC00.LPCB.EC0.CSEE (0xB8)
                    }

                    If ((Arg2 == 0x05))
                    {
                        ADBG ("[PEP] SWdrips entry")
                        If ((MSEN != One))
                        {
                            ADBG ("EC Notification on SWdrip Entry")
                            PESB (One)
                        }

                        ^^PC00.LPCB.EC0.CSEE (0xAE)
                    }

                    If ((Arg2 == 0x06))
                    {
                        ADBG ("[PEP] SWdrips exit")
                        If ((MSEN != One))
                        {
                            ADBG ("EC Notification on SWdrip Exit")
                            PESB (Zero)
                        }

                        ^^PC00.LPCB.EC0.CSEE (0xAF)
                    }
                }

                Return (Buffer (One)
                {
                     0x00                                             // .
                })
            }
        }
    }

