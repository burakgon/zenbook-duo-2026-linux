                    Return (Buffer (One)
                    {
                         0x00                                             // .
                    })
                }

                Device (PXSX)
                {
                    Name (_ADR, Zero)  // _ADR: Address
                    OperationRegion (PCCX, PCI_Config, Zero, 0x10)
                    Field (PCCX, ByteAcc, NoLock, Preserve)
                    {
                        DVID,   32, 
                        Offset (0x09), 
                        PIXX,   8, 
                        SCCX,   8, 
                        BCCX,   8
                    }

                    Method (PAHC, 0, Serialized)
                    {
                        If ((BCCX == One))
                        {
                            If ((SCCX == 0x06))
                            {
                                If ((PIXX == One))
                                {
                                    ADBG ("PSSD AHCI")
                                    Return (One)
                                }
                            }
                        }

                        Return (Zero)
                    }

                    Method (PNVM, 0, Serialized)
                    {
                        If ((BCCX == One))
                        {
                            If ((SCCX == 0x08))
                            {
                                If ((PIXX == 0x02))
                                {
                                    ADBG ("PSSD NVMe")
                                    Return (One)
                                }
                            }
                        }

                        Return (Zero)
                    }

                    Method (PRES, 0, Serialized)
                    {
                        If ((DVID == 0xFFFFFFFF))
                        {
                            Return (Zero)
                        }
                        Else
                        {
                            Return (One)
                        }
                    }

                    Method (ISGX, 0, Serialized)
                    {
                        If ((BCCX == 0x03))
                        {
                            Return (One)
                        }

                        Return (Zero)
                    }

                    If (CondRefOf (\STD3))
                    {
                        If ((STD3 != Zero))
                        {
                            Method (_DSD, 0, NotSerialized)  // _DSD: Device-Specific Data
                            {
                                If ((PAHC () || PNVM ()))
                                {
                                    ADBG ("NVMe D3 Support Enable for Child Device")
                                    Return (Package (0x02)
                                    {
                                        ToUUID ("5025030f-842f-4ab4-a561-99a5189762d0") /* Unknown UUID */, 
                                        Package (0x01)
                                        {
                                            Package (0x02)
                                            {
                                                "StorageD3Enable", 
                                                One
                                            }
                                        }
                                    })
                                }
                                Else
                                {
                                    Return (Package (0x02)
                                    {
                                        ToUUID ("5025030f-842f-4ab4-a561-99a5189762d0") /* Unknown UUID */, 
                                        Package (0x01)
                                        {
                                            Package (0x02)
                                            {
                                                "StorageD3Enable", 
                                                Zero
                                            }
                                        }
                                    })
                                }
                            }
                        }
                    }
                }

                Method (_PS0, 0, Serialized)  // _PS0: Power State 0
                {
                    ADBG (Concatenate ("_PS0 PCIe RP", ToHexString (SLOT)))
                    If (CondRefOf (PS0H))
                    {
                        ADBG ("Calling PCIE RP RTD3 PS0 Hook")
                        PS0H ()
                        ADBG ("Returned from PCIE RP RTD3 PS0 Hook")
                    }

                    If (CondRefOf (PPS0))
                    {
                        ADBG ("Calling Platform PCIE RP PS0 Hook")
                        PPS0 ()
                        ADBG ("Returned from Platform PCIE RP PS0 Hook")
                    }
                }

                Method (_PS3, 0, Serialized)  // _PS3: Power State 3
                {
                    ADBG (Concatenate ("_PS3 PCIe RP", ToHexString (SLOT)))
                    If (CondRefOf (PS3H))
                    {
                        ADBG ("Calling PCIE RP RTD3 PS3 Hook")
                        PS3H ()
                        ADBG ("Returned from PCIE RP RTD3 PS3 Hook")
                    }

                    If (CondRefOf (PPS3))
                    {
                        ADBG ("Calling Platform PCIE RP PS3 Hook")
                        PPS3 ()
                        ADBG ("Returned from Platform PCIE RP PS3 Hook")
                    }
                }

                Method (_DSD, 0, NotSerialized)  // _DSD: Device-Specific Data
                {
                    ADBG (Concatenate ("_DSD PCIe RP", ToHexString (SLOT)))
                    If (CondRefOf (ADSD))
                    {
                        ADBG (Concatenate ("Alternate _DSD PCIe RP", ToHexString (SLOT)))
                        Return (ADSD ())
                    }

                    If (CondRefOf (PINI))
                    {
                        Return (Package (0x04)
                        {
                            ToUUID ("fdf06fad-f744-4451-bb64-ecd792215b10") /* Unknown UUID */, 
                            Package (0x01)
                            {
                                Package (0x02)
                                {
                                    "FundamentalDeviceResetTriggeredOnD3ToD0", 
                                    One
                                }
                            }, 

                            ToUUID ("6b4ad420-8fd3-4364-acf8-eb94876fd9eb") /* Unknown UUID */, 
                            Package (0x00){}
                        })
                    }
                    Else
                    {
                        Return (Package (0x02)
                        {
                            ToUUID ("fdf06fad-f744-4451-bb64-ecd792215b10") /* Unknown UUID */, 
                            Package (0x01)
                            {
                                Package (0x02)
                                {
                                    "FundamentalDeviceResetTriggeredOnD3ToD0", 
                                    One
                                }
                            }
                        })
                    }
                }

                Method (HPME, 0, Serialized)
                {
                    If (((VDID != 0xFFFFFFFF) && (PMSX == One)))
                    {
                        Notify (PXSX, 0x02) // Device Wake
                        PMSX = One
                        PSPX = One
                    }
                }

                Method (DTRH, 0, Serialized)
                {
                    ADBG (Concatenate ("DTRH: RP = 0x", ToHexString (SLOT)))
                    Local0 = Zero
                    While ((Local0 < 0x08))
                    {
                        If ((SCB2 == Zero))
                        {
                            ADBG (Concatenate ("DTRH: DTR Stat = 0x", ToHexString (SCB2)))
                            Return (Zero)
                        }

                        If ((SCB2 == One))
                        {
                            ADBG (Concatenate ("DTRH: DTR Stat = 0x", ToHexString (SCB2)))
                            Return (Zero)
                        }

                        If ((SCB2 == 0x03))
                        {
                            ADBG (Concatenate ("DTRH: DTR Stat = 0x", ToHexString (SCB2)))
                            Sleep (0x0A)
                            Local0++
                            Continue
                        }

                        If ((LASX == Zero))
                        {
                            ADBG (Concatenate ("DTRH: Link active = 0x", ToHexString (LASX)))
                            Sleep (0x0A)
                            Local0++
                            Continue
                        }
                    }

                    If ((Local0 > 0x08))
                    {
                        ADBG ("DTRH: 80ms timeout")
                        Return (Zero)
                    }

                    If (CondRefOf (MTDL))
                    {
                        Name (DTLS, Zero)
                        Name (FSTE, Zero)
                        Name (DCNT, Zero)
                        If ((MTDL () == One))
                        {
                            DTLS = 0x05
                            ADBG ("DTRH: Set TLS to gen5")
                            If ((E32C == Zero))
                            {
                                ADBG ("DTRH: 1st Gen5 EQ")
                                FSTE = One
                            }
                            Else
                            {
                                ADBG ("DTRH: Complete Gen5 EQ before")
                                FSTE = Zero
                            }
                        }
                        ElseIf ((MTDL () == 0x02))
                        {
                            DTLS = 0x04
                            ADBG ("DTRH: Set TLS to gen4")
                        }
                        Else
                        {
                            Return (Zero)
                        }

                        If ((DTLS == LCLS))
                        {
                            ADBG ("DTRH: CLS already meet")
                            Return (Zero)
                        }

                        SCB2 = 0x03
                        If ((FSTE == One))
                        {
                            Local0 = L0SE /* \_SB_.PC00.RP12.L0SE */
                            Local1 = L01E /* \_SB_.PC00.RP12.L01E */
                            L0SE = Zero
                            L01E = Zero
                        }

                        LTLS = DTLS /* \_SB_.PC00.RP12.DTRH.DTLS */
                        LRLK = One
                        If ((FSTE == One))
                        {
                            While ((DCNT < 0x06))
                            {
                                If (((E32C == One) && (DTLS == LCLS)))
                                {
                                    Break
                                }

                                Sleep (0x0A)
                                DCNT++
                            }
                        }
                        Else
                        {
                            While ((DCNT < 0x05))
                            {
                                If ((DTLS == LCLS))
                                {
                                    Break
                                }

                                Sleep (0x0A)
                                DCNT++
                            }
                        }

                        If ((DCNT >= 0x06))
                        {
                            SCB2 = Zero
                            LTLS = LCLS /* \_SB_.PC00.RP12.LCLS */
                        }
                        Else
                        {
                            SCB2 = 0x02
                        }

                        If ((FSTE == One))
                        {
                            L0SE = Local0
                            L01E = Local1
                        }
                    }

                    Return (Zero)
                }
            }
        }
    }

    Scope (_SB.PC00.LPCB)
    {
    }

    Name (OU4V, 0xFF)
    Mutex (MUTX, 0x00)
    Mutex (OSUM, 0x00)
    Event (WFEV)
    OperationRegion (PRT0, SystemIO, 0x80, 0x02)
